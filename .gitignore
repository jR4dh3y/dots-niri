# Repository-level ignore: fish runtime/user-specific files
# Ignore fish history and universal variables (user-specific)
.config/fish/fish_history
.config/fish/fish_variables*
.config/fish/functions/
.config/fish/completions/
.config/fish/conf.d/


# Runtime / temp files created by fish
.config/fish/fishd.*
.config/fish/*.tmp*

# Editor backups / swap
.config/fish/*~
.config/fish/*.swp

# If you want to ignore everything in the fish dir except tracked configs,
# consider uncommenting the next line and adding explicit allow-lists.
# .config/fish/
