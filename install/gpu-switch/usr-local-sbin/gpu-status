#!/usr/bin/env bash
set -euo pipefail

GPU="0000:01:00.0"
AUDIO="0000:01:00.1"
VM="win10-rtx3050"

driver_for() {
  local dev="$1"
  if [[ -L "/sys/bus/pci/devices/$dev/driver" ]]; then
    basename "$(readlink -f "/sys/bus/pci/devices/$dev/driver")"
  else
    echo "none"
  fi
}

echo "GPU driver:   $(driver_for "$GPU")"
echo "Audio driver: $(driver_for "$AUDIO")"

if command -v virsh >/dev/null 2>&1; then
  state="$(virsh -c qemu:///system domstate "$VM" 2>/dev/null || true)"
  [[ -n "$state" ]] && echo "VM state:     $state"
fi

if command -v nvidia-smi >/dev/null 2>&1; then
  echo
  nvidia-smi 2>&1 | sed -n '1,18p' || true
fi

echo
lspci -nnk -s "${GPU#0000:}"
lspci -nnk -s "${AUDIO#0000:}"
