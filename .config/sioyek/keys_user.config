# Sioyek user keybindings (overrides / extends defaults)
# Docs: https://sioyek-documentation.readthedocs.io/en/latest/configuration.html
# Open this file in-app: :keys_user
# Modifiers: <C-x> ctrl, <A-x> alt, <S-x> shift
#
# Defaults keep most of the research workflow (/, t, b, h, m, p, f, …).
# This file only adds useful extras and a few ergonomic rebinds.

# ---------- Screen / page movement ----------
# J/K jump by half-ish screen (defaults use Space / Shift-Space / PgUp-PgDn)
screen_down                      J
screen_up                        K

# Whole page steps
next_page                        <C-j>
previous_page                    <C-k>
next_page                        ]
previous_page                    [

# Page edges — handy on two-column papers
goto_left_smart                  H
goto_right_smart                 L
goto_top_of_page                 {
goto_bottom_of_page              }

# ---------- Fit / zoom ----------
fit_to_page_width                w
fit_to_page_width_smart          W
fit_to_page_height               e
fit_to_page_height_smart         E
fit_to_page_width_ratio          <C-=>

# ---------- Modes ----------
toggle_dark_mode                 <f8>
toggle_custom_color              <C-f8>
toggle_presentation_mode         <f5>
toggle_mouse_drag_mode           <f6>
toggle_visual_scroll             <f7>
toggle_synctex                   <f4>
toggle_highlight                 <f1>
toggle_fullscreen                <f11>
toggle_statusbar                 <f2>
toggle_titlebar                  <f3>
toggle_horizontal_scroll_lock    <C-S-h>

# ---------- Document / history ----------
open_last_document               <C-Tab>
reload                           <C-r>

# ---------- Overview / definitions (papers) ----------
# Keep default: overview_definition = l, portal_to_definition = ]
# Extra: semicolon overview as a convenience near home row
overview_definition              ;

# ---------- Config quick-open ----------
prefs                            <C-,>
prefs_user                       <C-S-,>
keys                             <C-.>
keys_user                        <C-S-.>
