#!/usr/bin/env bash
set -euo pipefail

SCREENSHOT_DIR="${HOME}/Pictures/Screenshots"
MODE="${1:-screen}"
STAMP=$(date '+%Y-%m-%d %H%M%S')
OUTPUT="${SCREENSHOT_DIR}/Screenshot ${STAMP}.png"
TEMP=$(mktemp --suffix=.png)
trap 'rm -f "$TEMP"' EXIT

mkdir -p "$SCREENSHOT_DIR"

capture() {
    local target=$1
    local geometry output

    case "$MODE" in
        screen)
            grim "$target"
            ;;
        area|ocr|edit)
            geometry=$(slurp) || exit 0
            grim -g "$geometry" "$target"
            ;;
        output)
            output=$(slurp -o -f '%o') || exit 0
            grim -o "$output" "$target"
            ;;
        *)
            printf 'Usage: %s [screen|area|output|edit|ocr]\n' "$0" >&2
            exit 2
            ;;
    esac
}

case "$MODE" in
    ocr)
        capture "$TEMP"
        tesseract -l eng "$TEMP" stdout | wl-copy
        notify-send "Text copied" "OCR result is on the clipboard."
        ;;
    edit)
        capture "$TEMP"
        satty \
            --filename "$TEMP" \
            --output-filename "$OUTPUT" \
            --copy-command wl-copy \
            --early-exit all
        ;;
    *)
        capture "$OUTPUT"
        wl-copy --type image/png < "$OUTPUT"
        notify-send "Screenshot saved" "$OUTPUT"
        ;;
esac
