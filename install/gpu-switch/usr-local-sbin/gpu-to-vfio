#!/usr/bin/env bash
set -euo pipefail

GPU="0000:01:00.0"
AUDIO="0000:01:00.1"
VM="win10-rtx3050"
LOCK="/run/lock/gpu-switch.lock"

need_root() {
  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    echo "Run with sudo." >&2
    exit 1
  fi
}

driver_for() {
  local dev="$1"
  if [[ -L "/sys/bus/pci/devices/$dev/driver" ]]; then
    basename "$(readlink -f "/sys/bus/pci/devices/$dev/driver")"
  else
    echo "none"
  fi
}

unbind_if_bound() {
  local dev="$1"
  if [[ -L "/sys/bus/pci/devices/$dev/driver" ]]; then
    echo "$dev" > "/sys/bus/pci/devices/$dev/driver/unbind"
  fi
}

bind_to() {
  local dev="$1"
  local module="$2"
  local driver="$3"
  modprobe "$module"
  echo "$driver" > "/sys/bus/pci/devices/$dev/driver_override"
  if [[ "$(driver_for "$dev")" != "$driver" ]]; then
    unbind_if_bound "$dev"
    echo "$dev" > /sys/bus/pci/drivers_probe || true
  fi
  if [[ "$(driver_for "$dev")" != "$driver" ]]; then
    echo "$dev" > "/sys/bus/pci/drivers/$driver/bind"
  fi
  if [[ "$(driver_for "$dev")" != "$driver" ]]; then
    echo "Failed to bind $dev to $driver" >&2
    exit 1
  fi
}

unload_nvidia_modules() {
  local module

  for module in nvidia_drm nvidia_uvm nvidia_modeset nvidia; do
    if [[ -d "/sys/module/$module" ]] && ! modprobe -r "$module"; then
      echo "Warning: could not unload $module; the GPU is bound to VFIO but a stale NVIDIA module remains." >&2
    fi
  done
}

need_root
exec 9>"$LOCK"
flock -n 9 || { echo "Another GPU switch is already running." >&2; exit 1; }

for dev in "$GPU" "$AUDIO"; do
  [[ -d "/sys/bus/pci/devices/$dev" ]] || { echo "PCI device $dev is missing." >&2; exit 1; }
done

if command -v virsh >/dev/null 2>&1; then
  state="$(virsh -c qemu:///system domstate "$VM" 2>/dev/null || true)"
  if [[ "$state" == "running" || "$state" == "paused" ]]; then
    echo "$VM is already $state; GPU is presumably in VM mode." >&2
    exit 0
  fi
fi

systemctl stop nvidia-persistenced.service nvidia-powerd.service 2>/dev/null || true

if compgen -G "/dev/nvidia*" >/dev/null; then
  if users=$(fuser /dev/nvidia* 2>/dev/null); then
    echo "NVIDIA device is still in use. Close Linux games/apps first:" >&2
    echo "$users" >&2
    exit 1
  fi
fi

bind_to "$AUDIO" vfio_pci vfio-pci
bind_to "$GPU" vfio_pci vfio-pci
unload_nvidia_modules
udevadm settle --timeout=10 || true

echo "Switched to VFIO:"
echo "  $GPU -> $(driver_for "$GPU")"
echo "  $AUDIO -> $(driver_for "$AUDIO")"
