# Swaylock Beautiful Configuration - Static Theme
# Uses your default dark theme colors with enhanced effects

# Basic settings
ignore-empty-password
show-failed-attempts
show-keyboard-layout
daemonize

# Screenshot the current screen and use it as background
screenshots

# Blur and dim effects for beautiful lock screen
effect-blur=10x3
effect-scale=0.5
effect-vignette=0.4:0.8
effect-pixelate=5

# Clock display
clock
timestr=%I:%M %p
datestr=%A, %B %d

# Indicator positioning
indicator
indicator-radius=120
indicator-thickness=12
indicator-caps-lock
indicator-idle-visible

# Inside of indicator (circle)
inside-color=1A1B2688
inside-clear-color=7DCFFF88
inside-caps-lock-color=E0AF6888
inside-ver-color=7AA2F788
inside-wrong-color=F7768E88

# Ring colors
ring-color=41486888
ring-clear-color=7DCFFF
ring-caps-lock-color=E0AF68
ring-ver-color=7AA2F7
ring-wrong-color=F7768E

# Line (separator between ring and inside)
line-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
line-ver-color=00000000
line-wrong-color=00000000

# Text colors
text-color=C0CAF5
text-clear-color=1A1B26
text-caps-lock-color=1A1B26
text-ver-color=1A1B26
text-wrong-color=1A1B26

# Key highlight (when typing)
key-hl-color=9ECE6A

# Backspace highlight
bs-hl-color=F7768E

# Separator color (between indicator parts)
separator-color=00000000

# Layout text colors
layout-bg-color=00000000
layout-text-color=C0CAF5AA

# Fade in animation
fade-in=0.3

# Grace period (seconds before requiring password)
grace=2
grace-no-mouse
grace-no-touch
