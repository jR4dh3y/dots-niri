# Sioyek user preferences
# Theme: Nonchalant-Purple (matches dots-niri desktop)
# Docs: https://sioyek-documentation.readthedocs.io/en/latest/configuration.html
# Open this file in-app: :prefs_user

# ---------------------------------------------------------------------------
# Appearance
# ---------------------------------------------------------------------------

# Canvas around the PDF (outside the paper)
background_color                 0.118 0.118 0.125
dark_mode_background_color       0.118 0.118 0.125

# Dim pure white a bit in dark mode (less eye strain)
dark_mode_contrast               0.72
default_dark_mode                0

# Custom color mode (toggle with F8 / Ctrl-F8)
custom_background_color          0.118 0.118 0.125
custom_text_color                0.863 0.851 0.906

# ---------------------------------------------------------------------------
# Page separation
# ---------------------------------------------------------------------------
# Thin line on the page boundary. Color matches background so on white paper
# it reads as a clean dark break (same tone as the chrome around the page).

page_separator_width             2
page_separator_color             0.118 0.118 0.125

# ---------------------------------------------------------------------------
# Highlights & selection
# ---------------------------------------------------------------------------

text_highlight_color             0.773 0.620 0.863
search_highlight_color           0.765 0.984 0.357
link_highlight_color             0.773 0.620 0.863
synctex_highlight_color          1.000 0.722 0.424
visual_mark_color                0.290 0.231 0.373 0.35

highlight_color_a                0.773 0.620 0.863
highlight_color_g                0.765 0.984 0.357
highlight_color_o                1.000 0.722 0.424
highlight_color_r                1.000 0.431 0.475
highlight_color_y                1.000 1.000 0.400
highlight_color_b                0.000 0.460 0.860
highlight_color_p                1.000 0.660 0.730

# ---------------------------------------------------------------------------
# UI chrome
# ---------------------------------------------------------------------------

ui_font                          JetBrains Mono NFM
font_size                        14
status_bar_color                 0.165 0.165 0.173
status_bar_text_color            0.863 0.851 0.906
status_bar_font_size             13

# ---------------------------------------------------------------------------
# Reading & navigation
# ---------------------------------------------------------------------------

zoom_inc_factor                  1.2
vertical_move_amount             1.0
horizontal_move_amount           1.0
move_screen_ratio                0.55
touchpad_sensitivity             1.0
wheel_zoom_on_cursor             1

fit_to_page_width_ratio           0.92

ruler_mode                       1
ruler_padding                    1.0
ruler_x_padding                  5.0
visual_mark_next_page_fraction   0.75
visual_mark_next_page_threshold  0.25

should_draw_unrendered_pages     0
rerender_overview                1
prerender_next_page_presentation 1

linear_filter                    1

# ---------------------------------------------------------------------------
# Search
# ---------------------------------------------------------------------------

super_fast_search                1
case_sensitive_search            0

search_url_s                     https://scholar.google.com/scholar?q=
search_url_g                     https://www.google.com/search?q=
search_url_w                     https://en.wikipedia.org/wiki/Special:Search?search=
search_url_d                     https://duckduckgo.com/?q=
middle_click_search_engine       s
shift_middle_click_search_engine g

# ---------------------------------------------------------------------------
# Documents, bookmarks, TOC
# ---------------------------------------------------------------------------

sort_bookmarks_by_location                 1
create_table_of_contents_if_not_exists     1
max_created_toc_size                       5000
collapsed_toc                              0
flat_toc                                   0
multiline_menus                            1
show_doc_path                              0
item_list_prefix                           >

# ---------------------------------------------------------------------------
# Window / session behavior
# ---------------------------------------------------------------------------

check_for_updates_on_startup               0
should_load_tutorial_when_no_other_file    0
should_use_multiple_monitors               0

should_launch_new_instance                 0
should_launch_new_window                   0

single_click_selects_words                 0
should_warn_about_user_key_override        0
highlight_middle_click                     1

# ---------------------------------------------------------------------------
# Startup
# ---------------------------------------------------------------------------

startup_commands                 fit_to_page_width
