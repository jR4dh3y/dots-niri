#!/usr/bin/env bash
# Keep the guest qcow2 exclusive: detach host NBD before start, reconnect after stop.
set -euo pipefail

VM="${1:-}"
OP="${2:-}"
PHASE="${3:-}"

[[ "$VM" == "win10-rtx3050" ]] || exit 0

case "$OP:$PHASE" in
    prepare:begin|release:end|prepare:|release:)
        ;;
    *)
        exit 0
        ;;
esac

NBD="/dev/nbd0"
PART="${NBD}p3"
QCOW="/var/lib/libvirt/images-nocow/win10-rtx3050.qcow2"

log() {
    logger -t "libvirt-nbd-hook[$VM]" -- "$*"
}

nbd_connected() {
    [[ -s /sys/class/block/nbd0/pid ]]
}

unmount_guest_disk() {
    local target
    local -a targets=()

    while IFS= read -r target; do
        [[ -n "$target" ]] && targets+=("$target")
    done < <(findmnt -rn -S "$PART" -o TARGET 2>/dev/null || true)

    for target in "${targets[@]}"; do
        if ! umount "$target"; then
            log "refusing VM start: could not unmount $target"
            return 1
        fi
    done
}

disconnect_nbd() {
    local attempt

    nbd_connected || return 0
    qemu-nbd --disconnect "$NBD"

    for attempt in {1..50}; do
        nbd_connected || return 0
        sleep 0.1
    done

    log "refusing VM start: $NBD remained connected"
    return 1
}

case "$OP" in
    prepare)
        unmount_guest_disk
        disconnect_nbd
        log "host NBD detached; guest disk is ready"
        ;;
    release)
        if [[ ! -f "$QCOW" ]]; then
            log "cannot reconnect NBD: image is missing at $QCOW"
            exit 0
        fi

        modprobe nbd max_part=16
        if ! nbd_connected; then
            if qemu-nbd --cache=none --connect="$NBD" "$QCOW"; then
                blockdev --rereadpt "$NBD" || true
                udevadm settle --timeout=10 || true
                for _ in {1..50}; do
                    [[ -b "$PART" ]] && break
                    sleep 0.1
                done
                if [[ -b "$PART" ]]; then
                    log "reconnected $QCOW on $NBD"
                else
                    log "reconnected $QCOW on $NBD, but $PART did not appear"
                fi
            else
                log "failed to reconnect $QCOW on $NBD"
            fi
        fi
        ;;
esac
