#!/usr/bin/env bash
# libvirt qemu hook — free NBD before VM starts; reconnect after (no auto-mount)
set -euo pipefail

VM="${1:-}"
OP="${2:-}"

# Only act on the Windows VM
[[ "$VM" == "win10-rtx3050" ]] || exit 0

NBD="/dev/nbd0"
PART="${NBD}p3"
MNT="/mnt/windows"
QCOW="/var/lib/libvirt/images/win10-rtx3050.qcow2"

case "$OP" in
    prepare)
        # VM about to start — unmount if mounted and disconnect NBD so libvirt gets write lock
        if findmnt -n "$MNT" >/dev/null 2>&1; then
            umount "$MNT" 2>/dev/null || umount -l "$MNT" 2>/dev/null || true
        fi
        # also unmount any udisks mounts of the partition
        umount "$PART" 2>/dev/null || true
        qemu-nbd -d "$NBD" 2>/dev/null || true
        ;;
    release)
        # VM stopped — reconnect NBD so Dolphin can discover the volume; user mounts on demand
        modprobe nbd max_part=8 2>/dev/null || true
        qemu-nbd --cache=none -c "$NBD" "$QCOW" 2>/dev/null || true
        ;;
esac
